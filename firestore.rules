rules_version = '2';
// Regras de segurança do Mapa FTE.
// Copie TUDO isto para Firebase → Firestore Database → Regras → Publicar.
// A lista de emails em isAdmin() tem de ser igual à ADMINS de config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && email() in ['fjsoarez@gmail.com', 'fabio.soares@areas.com']; }
    function accPath() { return /databases/$(database)/documents/acessos/$(email()); }
    function hasAcc() { return signedIn() && exists(accPath()); }
    function acc() { return get(accPath()).data; }
    function hasAccess() { return isAdmin() || hasAcc(); }
    function canMark() { return isAdmin() || (hasAcc() && acc().role == 'gerente'); }
    // Locais que a pessoa pode ver. Lista vazia (ou sem lista) = todos os locais.
    function okLocal(cc) {
      return isAdmin() || (hasAcc() && (acc().get('locais', []).size() == 0 || cc in acc().get('locais', [])));
    }

    // Quadro de pessoal de cada mês: só os responsáveis alteram.
    match /meses/{ym} {
      allow read: if hasAccess();
      allow write: if isAdmin();
    }
    // Marcações (ausências e horas): cada gerente só nos seus locais.
    match /marcacoes/{id} {
      allow read: if hasAccess() && okLocal(resource.data.cc);
      allow create: if canMark() && okLocal(request.resource.data.cc);
      allow update: if canMark() && okLocal(resource.data.cc) && okLocal(request.resource.data.cc);
      allow delete: if isAdmin();
    }
    // Lista de quem tem acesso: só os responsáveis gerem; cada um lê o seu.
    match /acessos/{e} {
      allow read: if isAdmin() || (signedIn() && e == email());
      allow write: if isAdmin();
    }
  }
}
